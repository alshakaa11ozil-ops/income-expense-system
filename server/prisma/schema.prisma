generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  username       String         @unique
  email          String         @unique
  password       String
  role           Role           @default(USER)
  is_active      Boolean        @default(true)
  ai_daily_limit Int            @default(10)
  admin_note     String?
  last_login_at  DateTime?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  ai_cache       AiCache[]
  ai_usage       AiUsage[]
  records        Record[]
  refresh_tokens RefreshToken[]
  budget_goals   BudgetGoal[]
  categories     Category[]     @relation("UserCategories")

  @@index([email])
  @@index([role])
}

model RefreshToken {
  id         String    @id @default(cuid())
  token      String    @unique
  user_id    String
  expires_at DateTime
  created_at DateTime  @default(now())
  revoked_at DateTime?
  user_agent String?
  ip_address String?
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model Category {
  id         String   @id @default(cuid())
  name       String   @unique
  icon       String   @default("📁")       // emoji string — no file upload needed
  color      String   @default("#6B7280")  // hex color for UI badge
  is_active  Boolean  @default(true)
  user_id    String?                       // null for system categories
  created_by String                         // user_id of admin who created it
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user         User?      @relation("UserCategories", fields: [user_id], references: [id])
  records      Record[]
  budget_goals BudgetGoal[]

  @@index([name])
  @@index([is_active])
  @@index([user_id])
}

model Record {
  id          String     @id
  type        RecordType
  amount      Decimal    @db.Decimal(15, 2)
  category_id String
  category    Category   @relation(fields: [category_id], references: [id])
  date        DateTime   @db.Date
  operator    String
  notes       String?
  user_id     String
  deleted_at  DateTime?
  deleted_by  String?
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  user        User       @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([type])
  @@index([category_id])
  @@index([date])
  @@index([deleted_at])
}

model AiCache {
  id            String    @id @default(cuid())
  cache_key     String    @unique
  feature_name  AiFeature
  response_json String
  user_id       String
  hit_count     Int       @default(0)
  created_at    DateTime  @default(now())
  expires_at    DateTime
  user          User      @relation(fields: [user_id], references: [id])

  @@index([cache_key])
  @@index([expires_at])
  @@index([user_id])
}

model AiUsage {
  id           String    @id @default(cuid())
  user_id      String
  feature_name AiFeature
  was_cached   Boolean   @default(false)
  tokens_used  Int?
  created_at   DateTime  @default(now())
  user         User      @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([created_at])
  @@index([user_id, created_at])
}

model BudgetGoal {
  id          String   @id @default(cuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id])
  category_id String
  category    Category @relation(fields: [category_id], references: [id])
  amount      Decimal  @db.Decimal(15, 2)   // the goal amount
  month       Int      // 1–12
  year        Int      // 2026

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // One goal per category per month per user — no duplicates
  // One goal per category per month per user — no duplicates
@@unique([user_id, category_id, month, year])
  @@index([user_id])
  @@index([user_id, month, year])   // fast fetch: "give me all goals for May 2026"
}

enum Role {
  USER
  ADMIN
}

enum RecordType {
  income
  expense
}

enum AiFeature {
  plan_expenses
  advise_purchase
  analyze_finances
}

# =============================================================================
# FILE:    .env.example
# LAYER:   Configuration
# PURPOSE: Document every environment variable the app requires.
#          Copy this file to .env and fill in real values.
#          NEVER commit .env to version control.
# DEPENDS: dotenv (loaded in app.js and server.js)
# EXPORTS: n/a — shell environment variables
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------

# Port the Express server listens on
PORT=5000

# Environment: development | production | test
# Controls log verbosity, stack traces in error responses, etc.
NODE_ENV=development

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------

# Full PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Example: postgresql://postgres:secret@localhost:5432/income_expense_db
DATABASE_URL=postgresql://USER:134679@localhost:5432/income_expense_db

# -----------------------------------------------------------------------------
# JWT / AUTHENTICATION
# -----------------------------------------------------------------------------

# Secret used to sign access tokens — minimum 32 random characters
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_char_random_hex_string

# Secret used to sign refresh tokens — must be different from access secret
JWT_REFRESH_SECRET=replace_with_different_64_char_random_hex_string

# Access token lifetime (jsonwebtoken format: 15m, 1h, 2d, etc.)
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token lifetime
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------

# URL of the frontend application allowed to make cross-origin requests
# In production this must be your exact deployed frontend URL (no trailing slash)
CLIENT_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# GOOGLE GEMINI AI
# -----------------------------------------------------------------------------

# API key from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use for AI features
GEMINI_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------------------
# AI CACHE
# -----------------------------------------------------------------------------

# How long AI responses are cached before expiring (in seconds)
# Default: 3600 = 1 hour
AI_CACHE_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# BCRYPT
# -----------------------------------------------------------------------------

# Cost factor for bcrypt password hashing (10–12 recommended; higher = slower)
# Each increment doubles the hashing time — 12 takes ~400ms on modern hardware
BCRYPT_SALT_ROUNDS=12